# Copie para server/.env e preencha. O .env real nunca vai para o git.

# Banco: SQLite local. Em produção, a URL do PostgreSQL (Supabase).
DATABASE_URL=sqlite:///./cybercafe.db

# Chave que assina os logins do painel. Deixe vazia: na primeira subida o
# servidor gera uma aleatória e guarda em server/.secret_key (fora do git).
# Só preencha onde não há disco fixo (Render), com 32+ caracteres:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# O servidor não sobe com chave curta ou de exemplo.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Opcional: cria este admin ao iniciar, se ainda não existir nenhum.
# Útil no Render (sem terminal). Localmente, prefira: python -m app.cli
ADMIN_LOGIN=
ADMIN_SENHA=
